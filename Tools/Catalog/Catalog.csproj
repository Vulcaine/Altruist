    <ProjectReference Include="..\..\Altruist\Core\Core.csproj" />
    <ProjectReference Include="..\..\Altruist\Dashboard\Dashboard.csproj" />
    <ProjectReference Include="..\..\Altruist\DI\DI.csproj" />
    <ProjectReference Include="..\..\Altruist\EFCore\EFCore.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Autosave\Autosave.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Combat\Combat.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Inventory\Inventory.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Lobbies\Lobbies.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Main\Gaming.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Matchmaking\Matchmaking.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Movement\Movement.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Questing\Questing.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Regen\Regen.csproj" />
    <ProjectReference Include="..\..\Altruist\Gaming\Rooms\Rooms.csproj" />
    <ProjectReference Include="..\..\Altruist\Physx\Physx.csproj" />
    <ProjectReference Include="..\..\Altruist\Postgres\Postgres.csproj" />
