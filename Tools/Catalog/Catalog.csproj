<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates catalog/capabilities.json and catalog/CAPABILITIES.md from the framework assemblies, their XML docs,
       the source tree and catalog/map.yml. Run with the check option (see Program.cs) to fail when they are stale
       or when a service, config key or attribute belongs to no capability. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Altruist.Catalog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads declarations and string literals from the source tree the way the compiler does. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Altruist\Boot\Boot.csproj" />
