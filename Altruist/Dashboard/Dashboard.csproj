<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Altruist.Dashboard</PackageId>
    <!-- Matches [ConditionalOnAssembly("Altruist.Dashboard")] on the world viewer controller/portal. -->
    <AssemblyName>Altruist.Dashboard</AssemblyName>
    <RootNamespace>Altruist.Dashboard</RootNamespace>
    <Description>Dashboard module for Altruist framework.</Description>
    <Version>0.9.9-beta</Version>
    <Copyright>Copyright © 2025 Aron Gere</Copyright>
    <PackageReadmeFile>./README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Vulcaine/Altruist</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The dashboard app (App/, built with `npm run build`; dist/ is committed so packing needs no Node). The embedded
       files manifest keeps their folders ("assets/index.js"), which plain resource names cannot (ManifestEmbeddedFileProvider). -->
  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="App\dist\**" />
  </ItemGroup>

  <!-- The app's sources (and node_modules, which ships stray .cs files such as node-gyp's Find-VisualStudio.cs) are
       never C# source. -->
  <ItemGroup>
    <Compile Remove="App\**" />
    <None Remove="App\**" />
    <Content Remove="App\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestApp\**\*" />
    <EmbeddedResource Remove="TestApp\**\*" />
    <None Remove="TestApp\**\*" />
    <Content Remove="TestApp\**\*" />
  </ItemGroup>

  <!-- Generates the embedded files manifest (GenerateEmbeddedFilesManifest above). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
  </ItemGroup>
  
  <ItemGroup Condition="'$(UseLocalProjects)' == 'true'">
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalProjects)' != 'true'">
    <PackageReference Include="Altruist" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

</Project>
