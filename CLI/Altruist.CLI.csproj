<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>altruist</ToolCommandName>
    <PackageId>Altruist.CLI</PackageId>
    <Version>0.9.9-beta</Version>
    <Authors>Aron Gere</Authors>
    <Description>CLI tool for the Altruist game server framework: create and run projects, and an MCP server that gives coding agents the capability catalog and a read-only view of the running server.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Vulcaine/Altruist</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <!-- The catalog of the framework version this CLI ships with (generated by Tools/Catalog). -->
  <ItemGroup>
    <EmbeddedResource Include="..\catalog\capabilities.json" LogicalName="capabilities.json" />
  </ItemGroup>

</Project>
